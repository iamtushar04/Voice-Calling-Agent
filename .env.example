# ────────────────────────────────────────────────────────────────────────────
# AI Voice Agent — Environment Variables
# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control
# ────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="AI Voice Agent"
APP_VERSION="0.1.0"
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ── Twilio ────────────────────────────────────────────────────────────────────
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Your public webhook URL (ngrok URL during development)
# Example: https://abc123.ngrok.io
TWILIO_WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok.io

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://voice:voice@localhost:5432/voice_agent

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM ───────────────────────────────────────────────────────────────────────
# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Google Gemini (alternative)
GEMINI_API_KEY=

# ── STT — Deepgram ────────────────────────────────────────────────────────────
# https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_MODEL=nova-2

# ── TTS — ElevenLabs ──────────────────────────────────────────────────────────
# https://elevenlabs.io/app/speech-synthesis
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Default voice: Rachel (natural, professional)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Agent defaults ────────────────────────────────────────────────────────────
AGENT_SILENCE_TIMEOUT_SECONDS=5
AGENT_MAX_SILENCE_RETRIES=2
AGENT_INITIAL_GREETING_TIMEOUT_SECONDS=10

# ── Concurrency ───────────────────────────────────────────────────────────────
DEFAULT_MAX_CONCURRENT_CALLS=5
